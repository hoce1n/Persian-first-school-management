@page "/schoolinfo"
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject IJSRuntime JSRuntime
<PageTitle>تنظیمات</PageTitle>

<div class="container mx-auto p-4">
    <h3 class="text-2xl font-bold mb-6">مدیریت اطلاعات مدرسه</h3>

    <div class="bg-white p-6 rounded-lg shadow-md max-w-md">
        <label class="block text-sm font-medium mb-2">نام مدرسه</label>
        <InputText class="w-full p-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 mb-4" 
                   @bind-Value="schoolName" 
                   placeholder="نام مدرسه را وارد کنید" />
        <button class="inline-flex items-center justify-center whitespace-nowrap text-sm ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-neutral-900 hover:bg-neutral-900/90 h-10 px-4 py-2 w-full rounded-xl hover:cursor-pointer text-white font-medium shadow-md" 
                @onclick="SaveSchoolInfo" disabled="@string.IsNullOrWhiteSpace(schoolName)">
            ذخیره تغییرات
        </button>
        @if (!string.IsNullOrEmpty(message))
        {
            <div class="mt-4 p-2 rounded-md @messageClass">@message</div>
        }
    </div>
</div>

@code {
    private string? schoolName;
    private string? message;
    private string messageClass = "";

    protected override async Task OnInitializedAsync()
    {
        using var context = DbContextFactory.CreateDbContext();
        var schoolInfo = await context.SchoolInfos.FirstOrDefaultAsync();
        if (schoolInfo != null)
        {
            schoolName = schoolInfo.SchoolName;
        }
        else
        {
            schoolName = "مدرسه پیش‌فرض";
            message = "هیچ اطلاعاتی برای مدرسه ثبت نشده است.";
            messageClass = "bg-neutral-300 text-neutral-800 text-center text-sm";
        }
    }

    private async Task SaveSchoolInfo()
    {
        if (string.IsNullOrWhiteSpace(schoolName))
        {
            message = "نام مدرسه نمی‌تواند خالی باشد.";
            messageClass = "bg-red-100 text-red-800 text-center text-sm";
            StateHasChanged();
            return;
        }

        using var context = DbContextFactory.CreateDbContext();
        try
        {
            var schoolInfo = await context.SchoolInfos.FirstOrDefaultAsync();
            if (schoolInfo != null)
            {
                schoolInfo.SchoolName = schoolName;
            }
            else
            {
                schoolInfo = new SchoolInfo { SchoolName = schoolName };
                context.SchoolInfos.Add(schoolInfo);
            }
            await context.SaveChangesAsync();
            message = "تغییرات با موفقیت ذخیره شد.";
            messageClass = "bg-green-100 text-green-800 text-center text-sm";
        }
        catch (Exception ex)
        {
            message = $"خطا در ذخیره: {ex.Message}";
            messageClass = "bg-red-100 text-red-800 text-center text-sm";
        }
        StateHasChanged();
    }
}